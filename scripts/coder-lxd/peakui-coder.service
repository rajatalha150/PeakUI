[Unit]
Description=PeakUI Coder workspace router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/peakui-coder.env
Environment=HOME=/root
Environment=PUPPETEER_CACHE_DIR=/opt/puppeteer-cache
Environment=ANDROID_HOME=/opt/android-sdk
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
Environment=PATH=/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/cmake/3.22.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/workspace
ExecStartPre=/usr/local/bin/peakui-coder-prepare
ExecStartPre=/usr/local/bin/peakui-coder-readiness --startup
ExecStart=/usr/local/bin/node /opt/peakui/coder/workspace-router.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
