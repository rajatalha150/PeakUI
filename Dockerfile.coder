# Coder container: Qwen Code coding environment (brain = Qwen Code, model = local Ollama)

# Node 22 base (qwen-code requires Node >= 22). Debian-based so we can apt the
# full dev toolchain.
FROM node:22-bookworm-slim

# --- Dev toolchain ----------------------------------------------------------
# Keep this lean-but-complete: the agent shells out for builds/tests/git, and
# the user can install more from the UI.
# `procps` is REQUIRED, not cosmetic: during shutdown the daemon snapshots the
# ACP child's process tree with /bin/ps and logs
#   "ACP child pid=N process-tree snapshot failed: spawn /bin/ps ENOENT"
# then fails to reap the child ("daemon shutdown incomplete"). Without it a
# container restart can leave an orphaned ACP process holding the workspace.
#
# The font + Chrome-runtime-libs block is REQUIRED for the agent's real-browser
# visual verification. A bare node:*-slim image has NO fonts and NO fontconfig,
# so Chrome's Skia backend aborts the renderer with "Fontconfig error: Cannot
# load default config file" + "FATAL ... Not implemented", which puppeteer
# surfaces as a misleading "Navigating frame was detached". The ~20 libs are
# Chrome's shared-library dependencies; without them `ldd <chrome>` reports
# "not found" for libnss3/libgbm1/libatk/... and launch fails. Baking these in
# means a fresh VM has a working browser with zero runtime surgery.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      curl \
      ca-certificates \
      build-essential \
      openjdk-17-jdk-headless \
      python3 \
      python3-pip \
      python3-venv \
      procps \
      jq \
      ripgrep \
      unzip \
      zip \
      openssh-client \
      sqlite3 \
      fontconfig \
      fontconfig-config \
      fonts-dejavu-core \
      fonts-liberation \
      libglib2.0-0 \
      libnss3 \
      libnspr4 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libatspi2.0-0 \
      libdbus-1-3 \
      libgbm1 \
      libx11-6 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      libxi6 \
      libxrender1 \
      libdrm2 \
      libasound2 \
      libpango-1.0-0 \
      libcairo2 \
      libcups2 \
      libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

# Go + Rust are optional-heavy; install via toolchain managers so versions stay
# current and installs are opt-in. We include Go for a useful out-of-the-box
# experience.
ARG GO_VERSION=1.22.5
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ENV PATH="/usr/local/go/bin:${PATH}" \
    JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64" \
    ANDROID_HOME="/opt/android-sdk" \
    ANDROID_SDK_ROOT="/opt/android-sdk"

# --- Qwen Code (built from pinned source, not the npm registry) -------------
# The npm package name is flagged by a heuristic scanner (false positive for
# this heavy agentic CLI); we clone the official pinned source and build it so
# the image is fully auditable.
ARG QWEN_CODE_VERSION=0.23.4
WORKDIR /opt/qwen-code
RUN git clone --depth 1 --branch "v${QWEN_CODE_VERSION}" \
      https://github.com/QwenLM/qwen-code.git /opt/qwen-code \
    && npm ci \
    && npm run build \
    && npm cache clean --force

# --- Workspace (persistent project dir) --------------------------------------
# Mounted as a volume so projects + qwen's ~/.qwen state survive restarts.
RUN mkdir -p /workspace /opt/android-sdk /root/.gradle /root/.android /root/.npm /root/.cache/pip
WORKDIR /workspace

# --- Real-browser verification harness --------------------------------------
# Bakes in puppeteer + jsdom + both Chrome builds so the agent can visually
# verify the static sites on a fresh VM without re-downloading anything at
# runtime (which was the failure mode after an image reset wiped /root/.cache).
# The harness script lives at /opt/qwen-code/browser/verify-site.mjs and is
# committed in scripts/coder-browser/.
#
# Chrome is cached OUTSIDE /root (at /opt/puppeteer-cache, image-managed) so
# that /root can be mounted as a persistent volume for SSH keys/git identity
# without shadowing the browser cache. PUPPETEER_CACHE_DIR is set BEFORE the
# install so build-time download and runtime resolution agree.
ENV PUPPETEER_CACHE_DIR=/opt/puppeteer-cache
COPY scripts/coder-browser /opt/qwen-code/browser
WORKDIR /opt/qwen-code/browser
RUN npm install --no-audit --no-fund \
    && npx puppeteer browsers install chrome-headless-shell \
    && npx puppeteer browsers install chrome \
    && npm cache clean --force
WORKDIR /workspace

# Git identity for the agent's commits. The container runs as root and git is
# installed, but `git commit` fails without user.name/user.email. Set both the
# env vars (used at commit time) and `git config --global` (so it shows up in
# `git config --list` and tools that read config rather than env). Env-driven so
# operators can override the author per deployment without a rebuild.
ENV GIT_AUTHOR_NAME="PeakUI Coding Agent" \
    GIT_AUTHOR_EMAIL="agent@peakui.local" \
    GIT_COMMITTER_NAME="PeakUI Coding Agent" \
    GIT_COMMITTER_EMAIL="agent@peakui.local"
RUN git config --global user.name "PeakUI Coding Agent" \
    && git config --global user.email "agent@peakui.local" \
    && git config --global init.defaultBranch "main"

# --- Runtime ----------------------------------------------------------------
# The daemon binds loopback; host networking exposes it to the app. A bearer
# token is required on non-loopback binds (QWEN_SERVER_TOKEN).
ENV QWEN_SERVER_TOKEN=""

EXPOSE 4170

# Model-list sync: mirror Ollama's live models into ~/.qwen/settings.json so the
# daemon can route to every model (local + cloud) the UI offers.
COPY scripts/sync-coder-models.mjs /opt/qwen-code/sync-coder-models.mjs
COPY scripts/coder-storage/peakui-coder-readiness /usr/local/bin/peakui-coder-readiness
COPY scripts/coder-storage/peakui-cleanup /usr/local/bin/peakui-cleanup
COPY scripts/coder-storage/peakui-coder-start /usr/local/bin/peakui-coder-start
RUN chmod 755 /usr/local/bin/peakui-coder-readiness /usr/local/bin/peakui-cleanup /usr/local/bin/peakui-coder-start

# Workspace context file (QWEN.md): the daemon auto-loads this into every
# session so the agent doesn't re-derive the project layout + verify commands,
# and knows to delegate writing to the `peakui-writer` subagent when one is
# configured. Seeded to BOTH the global location (`~/.qwen/QWEN.md`, which the
# daemon always loads regardless of the session cwd) and the primary workspace.
COPY scripts/coder-workspace/QWEN.md /opt/qwen-code/workspace-qwen.md

# Entrypoint: refresh the context file, sync models, then run the daemon. Binds
# loopback (secure, no token); host networking + the loopback port map expose
# it to the app. `--enable-session-shell` exposes POST /session/:id/shell so the
# UI can offer an on-demand terminal pop-up; it is permitted on trusted loopback
# (no bearer token) which is exactly this container's bind.
#   - global ~/.qwen/QWEN.md is OVERWRITTEN each boot (always-loaded context);
#   - /workspace/QWEN.md is also overwritten (it is a managed seed, not a user
#     file — a stale copy here caused confusion when it silently diverged).
#   - /root is a persistent volume (SSH keys, git identity, npm cache). The
#     git identity is seeded ONLY IF UNSET (first boot of a fresh volume), so a
#     user's custom identity persists across recreates instead of being
#     clobbered each boot. GIT_AUTHOR_* env vars remain set regardless.
CMD ["/usr/local/bin/peakui-coder-start"]
