# Coder container: Qwen Code coding environment (brain = Qwen Code, model = local Ollama)

# Node 22 base (qwen-code requires Node >= 22). Debian-based so we can apt the
# full dev toolchain.
FROM node:22-bookworm-slim

# --- Dev toolchain ----------------------------------------------------------
# Keep this lean-but-complete: the agent shells out for builds/tests/git, and
# the user can install more from the UI.
# `procps` is REQUIRED, not cosmetic: during shutdown the daemon snapshots the
# ACP child's process tree with /bin/ps and logs
#   "ACP child pid=N process-tree snapshot failed: spawn /bin/ps ENOENT"
# then fails to reap the child ("daemon shutdown incomplete"). Without it a
# container restart can leave an orphaned ACP process holding the workspace.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      curl \
      ca-certificates \
      build-essential \
      python3 \
      python3-pip \
      python3-venv \
      procps \
      jq \
      ripgrep \
      unzip \
      openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Go + Rust are optional-heavy; install via toolchain managers so versions stay
# current and installs are opt-in. We include Go for a useful out-of-the-box
# experience.
ARG GO_VERSION=1.22.5
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ENV PATH="/usr/local/go/bin:${PATH}"

# --- Qwen Code (built from pinned source, not the npm registry) -------------
# The npm package name is flagged by a heuristic scanner (false positive for
# this heavy agentic CLI); we clone the official pinned source and build it so
# the image is fully auditable.
ARG QWEN_CODE_VERSION=0.23.4
WORKDIR /opt/qwen-code
RUN git clone --depth 1 --branch "v${QWEN_CODE_VERSION}" \
      https://github.com/QwenLM/qwen-code.git /opt/qwen-code \
    && npm ci \
    && npm run build \
    && npm cache clean --force

# --- Workspace (persistent project dir) --------------------------------------
# Mounted as a volume so projects + qwen's ~/.qwen state survive restarts.
RUN mkdir -p /workspace
WORKDIR /workspace

# Git identity for the agent's commits. The container runs as root and git is
# installed, but `git commit` fails without user.name/user.email. Env-driven so
# operators can override the author per deployment without a rebuild.
ENV GIT_AUTHOR_NAME="PeakUI Coding Agent" \
    GIT_AUTHOR_EMAIL="agent@peakui.local" \
    GIT_COMMITTER_NAME="PeakUI Coding Agent" \
    GIT_COMMITTER_EMAIL="agent@peakui.local"

# --- Runtime ----------------------------------------------------------------
# The daemon binds loopback; host networking exposes it to the app. A bearer
# token is required on non-loopback binds (QWEN_SERVER_TOKEN).
ENV QWEN_SERVER_TOKEN=""

EXPOSE 4170

# Model-list sync: mirror Ollama's live models into ~/.qwen/settings.json so the
# daemon can route to every model (local + cloud) the UI offers.
COPY scripts/sync-coder-models.mjs /opt/qwen-code/sync-coder-models.mjs

# Entrypoint: sync models, then run the daemon. Binds loopback (secure, no
# token); host networking + the loopback port map expose it to the app.
# `--enable-session-shell` exposes POST /session/:id/shell so the UI can offer
# an on-demand terminal pop-up; it is permitted on trusted loopback (no bearer
# token) which is exactly this container's bind.
CMD ["sh", "-c", "node /opt/qwen-code/sync-coder-models.mjs && exec node /opt/qwen-code/scripts/cli-entry.js serve --hostname 127.0.0.1 --port 4170 --workspace /workspace --no-web --enable-session-shell"]
