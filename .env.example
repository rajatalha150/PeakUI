# PeakUI Environment Configuration
# Copy this file to .env and fill in your own values before running docker compose.
# Do not commit real secrets to version control.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by the app container.
# Linux / macOS (host-mode compose): postgresql://peakui:CHANGE_ME@localhost:5432/peakui
# Windows Docker Desktop (bridge network): postgresql://peakui:CHANGE_ME@db:5432/peakui
DATABASE_URL=postgresql://peakui:CHANGE_ME@localhost:5432/peakui

# Strong secret for signing JWT sessions. Minimum 32 characters.
# Generate with: head -c 48 /dev/urandom | base64
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Ollama base URL used as the default for new users.
# Linux / macOS host-mode: http://127.0.0.1:11434
# Windows Docker Desktop: http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Enables integration with the optional host-side shell executor.
# Must match the token used when starting scripts/openclaw-host-executor.mjs
OPENCLAW_HOST_EXECUTOR_TOKEN=

# Host directory mounted as the managed workspace inside the container.
# Linux / macOS example:
OPENCLAW_HOST_WORKSPACE_DIR=/tmp/peakui-openclaw-workspace
# Windows example:
# OPENCLAW_HOST_WORKSPACE_DIR=C:\Users\%USERNAME%\peakui-workspace

# Host directory mounted read-only for home-path inspection.
# Linux / macOS example:
OPENCLAW_HOST_HOME_DIR=/home
# Windows example:
# OPENCLAW_HOST_HOME_DIR=C:\Users\%USERNAME%

# Host temp directory mounted read-only.
# Linux / macOS example:
OPENCLAW_HOST_TMP_DIR=/tmp
# Windows example:
# OPENCLAW_HOST_TMP_DIR=C:\Users\%USERNAME%\AppData\Local\Temp

# URL of the optional host executor for shell commands.
# Linux / macOS:
OPENCLAW_HOST_EXECUTOR_URL=http://127.0.0.1:4318
# Windows Docker Desktop:
# OPENCLAW_HOST_EXECUTOR_URL=http://host.docker.internal:4318

# SOCKS proxy for UWAF stealth browsing. Defaults are set by docker-compose.
# Linux / macOS host-mode:
TOR_PROXY_URL=socks5://localhost:9050
# Windows Docker Desktop:
# TOR_PROXY_URL=socks5://tor-proxy:9150

# -----------------------------------------------------------------------------
# Optional Search Providers
# -----------------------------------------------------------------------------

BRAVE_API_KEY=
SEARXNG_URL=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# -----------------------------------------------------------------------------
# Optional UWAF Stealth Provider Overrides
# -----------------------------------------------------------------------------
# See docs/settings-and-rag.md for the approved provider catalog.

# UWAF_STEALTH_PROVIDER_TOR66_HOME_URL=
# UWAF_STEALTH_PROVIDER_TOR66_QUERY_URL=
# UWAF_STEALTH_PROVIDER_TORCH_HOME_URL=
# UWAF_STEALTH_PROVIDER_TORCH_QUERY_URL=
# UWAF_STEALTH_PROVIDER_OUR_REALM_HOME_URL=
# UWAF_STEALTH_PROVIDER_OUR_REALM_QUERY_URL=
# UWAF_STEALTH_PROVIDER_TORCH_BY_TORDEX_HOME_URL=
# UWAF_STEALTH_PROVIDER_TORCH_BY_TORDEX_QUERY_URL=

# -----------------------------------------------------------------------------
# Operational Limits
# -----------------------------------------------------------------------------

# Server-side cap for requested Ollama context.
PEAKUI_OLLAMA_CONTEXT_CAP=
